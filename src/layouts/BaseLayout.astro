---
interface Props { title: string; description: string }
const { title, description } = Astro.props;
const canonical = Astro.url;
---
<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09283f" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>
<style is:global>
  :root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:#102b3f;background:#f3f6f7;font-synthesis:none;text-rendering:optimizeLegibility;--navy:#09283f;--navy-2:#123d57;--teal:#00a58a;--teal-dark:#087665;--lime:#d5ed74;--paper:#f3f6f7;--ink:#102b3f;--muted:#526674;--line:#d5dfe2;--radius:1.2rem}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:6rem}body{margin:0;line-height:1.6}a{color:inherit}a:focus-visible,summary:focus-visible{outline:3px solid #e5b600;outline-offset:4px;border-radius:3px}.skip-link{position:absolute;left:1rem;top:-5rem;background:#fff;color:var(--ink);padding:.7rem 1rem;z-index:20}.skip-link:focus{top:1rem}.topbar{position:sticky;top:0;z-index:10;background:rgba(9,40,63,.97);color:white;border-bottom:1px solid rgba(255,255,255,.14);backdrop-filter:blur(12px)}.nav-wrap{max-width:1200px;margin:auto;padding:.8rem 1.25rem;display:flex;align-items:center;justify-content:space-between;gap:1.5rem}.brand{display:flex;align-items:center;gap:.7rem;text-decoration:none;font-weight:800;line-height:1.1}.brand-mark{display:grid;place-items:center;width:2.35rem;height:2.35rem;border:1px solid rgba(255,255,255,.45);border-radius:.55rem;color:var(--lime);font-size:.75rem;letter-spacing:.06em}.brand-text small{display:block;color:#c7d8e1;font-size:.7rem;font-weight:500;margin-top:.2rem}.nav-links{display:flex;align-items:center;gap:1.1rem}.nav-links a{font-size:.85rem;color:#e5eef2;text-decoration:none}.nav-links a:hover{color:var(--lime)}.nav-cta{padding:.55rem .8rem;border:1px solid rgba(255,255,255,.4);border-radius:99px}.hero{position:relative;overflow:hidden;min-height:560px;background:var(--navy);color:white;padding:5rem max(calc((100% - 1120px)/2),1.4rem) 2rem;display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:2rem}.hero-copy{max-width:670px;position:relative;z-index:1}.eyebrow{text-transform:uppercase;letter-spacing:.13em;font-weight:750;font-size:.72rem;color:var(--teal-dark);margin:0 0 .8rem}.hero .eyebrow,.section-dark .eyebrow,.section-blue .eyebrow{color:var(--lime)}h1,h2,h3,p{margin-top:0}h1{font-size:clamp(3rem,7.6vw,6.1rem);letter-spacing:-.055em;line-height:.99;max-width:11ch;margin:0 0 1.25rem}h2{font-size:clamp(2rem,4.2vw,3.55rem);letter-spacing:-.045em;line-height:1.05;margin:0 0 1rem}h3{font-size:1.15rem;line-height:1.2;letter-spacing:-.02em;margin:0 0 .7rem}.lead{font-size:1.22rem;max-width:38rem;color:#d8e7ee}.hero-actions{display:flex;align-items:center;gap:1.2rem;flex-wrap:wrap;margin:2rem 0 1rem}.button{display:inline-flex;align-items:center;justify-content:center;gap:.7rem;padding:.9rem 1.15rem;font-weight:750;border-radius:99px;text-decoration:none}.button-accent{background:var(--lime);color:var(--navy)}.button-dark{background:var(--navy);color:#fff}.text-link{color:white;font-weight:650}.hero-source{font-size:.78rem;color:#bfd0da}.hero-source a,.source-note a,.small-source a{color:inherit;text-decoration-thickness:1px;text-underline-offset:3px}.hero-art{height:340px;position:relative;display:grid;place-items:center}.orbit{position:absolute;border:1px solid rgba(213,237,116,.35);border-radius:50%;transform:rotate(-28deg)}.orbit-one{width:340px;height:215px}.orbit-two{width:450px;height:300px;transform:rotate(34deg);border-color:rgba(0,165,138,.48)}.chip{position:relative;z-index:1;width:175px;height:175px;border-radius:2.4rem;transform:rotate(-8deg);background:linear-gradient(145deg,#d5ed74,#82d9aa);color:var(--navy);display:flex;flex-direction:column;justify-content:space-between;padding:1.2rem;box-shadow:0 30px 80px #00152188}.chip span{font-weight:850;letter-spacing:.16em}.chip b{font-size:4rem;line-height:1;letter-spacing:-.08em}.dot{position:absolute;width:.8rem;height:.8rem;border-radius:50%;background:var(--lime);box-shadow:0 0 25px var(--lime)}.dot-one{top:18%;right:19%}.dot-two{bottom:20%;left:13%;background:#00d0a9}.dot-three{top:45%;left:8%;width:.45rem;height:.45rem}.art-label{position:absolute;right:0;bottom:2%;font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;color:#c9d7dd}.hero-facts{grid-column:1/-1;display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #ffffff2e;margin-top:1.8rem;padding-top:1.2rem;max-width:680px}.hero-facts div{display:grid;gap:.1rem}.hero-facts span{font-size:.72rem;color:#b9ced8}.hero-facts strong{font-size:1rem}.section{padding:5.5rem max(calc((100% - 1120px)/2),1.4rem)}.section-paper{background:var(--paper)}.section-blue{background:var(--navy-2);color:white}.section-dark{background:#071f31;color:white}.section-accent{background:#d9f0e7}.section-heading{max-width:760px;margin-bottom:2.7rem}.section-heading>p:not(.eyebrow):not(.source-note):not(.notice){max-width:680px;color:var(--muted);font-size:1.05rem}.section-dark .section-heading>p:not(.eyebrow):not(.source-note),.section-blue .section-heading>p:not(.eyebrow):not(.source-note){color:#d0dfe5}.source-note{font-size:.8rem;color:var(--muted);margin:.8rem 0 0}.section-dark .source-note,.section-blue .source-note{color:#b8cbd3}.compare-intro{margin:3.5rem 0 1.2rem}.compare-intro h3{font-size:1.6rem}.compare-intro>p:last-child{color:var(--muted)}.compare-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.compare-card{padding:1.5rem;border-radius:var(--radius);background:white;border:1px solid var(--line);display:flex;flex-direction:column;min-height:280px}.compare-card p{color:var(--muted);font-size:.93rem}.compare-card a{margin-top:auto;font-weight:700;color:var(--teal-dark);font-size:.86rem}.compare-main{background:var(--navy);color:white;border-color:var(--navy)}.compare-main p{color:#d0dfe5}.compare-main a{color:var(--lime)}.tag{display:inline-flex;align-self:flex-start;font-size:.68rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;padding:.3rem .55rem;border-radius:99px;background:var(--lime);color:var(--navy);margin-bottom:1.15rem}.tag-light{background:#e4f1ee;color:#116856}.compare-fact{font-size:.82rem!important;font-weight:700}.interpretation{border-left:3px solid var(--teal);padding:.8rem 1rem;background:#e6f4f0;margin:1.5rem 0 0;font-size:.9rem}.skill-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.skill-grid article{padding:1.4rem;border:1px solid #ffffff33;border-radius:var(--radius);background:#ffffff0a}.skill-grid article>span{font-size:.75rem;color:var(--lime);font-weight:800}.skill-grid p{color:#d0dfe5;margin-bottom:0}.notice{padding:1rem 1.1rem;background:#fff5d7;border-left:4px solid #c48b00;color:#493b14;border-radius:.25rem;font-size:.9rem}.semester-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.85rem}.semester-card{background:white;border:1px solid var(--line);border-radius:.85rem;padding:1.1rem;display:flex;flex-direction:column;min-height:300px}.semester-year{font-size:.7rem;color:var(--teal-dark);text-transform:uppercase;letter-spacing:.08em;font-weight:800;margin:0}.semester-card h3{margin:.35rem 0 .7rem}.semester-card ul{padding-left:1.1rem;color:#405665;font-size:.83rem}.semester-card li{padding:.2rem 0}.small-source{font-size:.73rem;color:var(--muted);margin-top:auto}.work-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem;align-items:stretch}.work-copy{padding:1.2rem 1.3rem 1rem 0}.work-copy p{color:#c1d1d9}.metric{background:#10334a;border:1px solid #ffffff24;border-radius:var(--radius);padding:1.4rem}.metric>p{color:#d6e4e9;font-size:.85rem;margin-bottom:.6rem}.metric strong{display:block;font-size:clamp(2.4rem,5vw,3.4rem);letter-spacing:-.06em;color:var(--lime);line-height:1.1}.metric strong span{font-size:1.3rem;letter-spacing:0}.metric small{display:block;color:#bdcdd5;line-height:1.5;margin-top:1rem}.support-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.support-card{background:white;border:1px solid var(--line);border-radius:var(--radius);padding:1.5rem}.support-mark{display:block;font-size:.74rem;font-weight:850;color:var(--teal-dark);margin-bottom:2rem}.support-card p{font-size:.9rem;color:var(--muted)}.support-card a{color:var(--teal-dark);font-weight:700;font-size:.85rem}.admission-layout{display:grid;grid-template-columns:1.3fr .7fr;gap:1rem}.weight-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.75rem}.weight-grid div{display:grid;gap:.5rem;background:#fff;border:1px solid #c8dfd6;padding:1rem;border-radius:.8rem}.weight-grid span{font-size:.78rem;color:var(--muted)}.weight-grid strong{font-size:1.45rem;color:var(--navy)}.admission-aside{background:var(--lime);padding:1.35rem;border-radius:var(--radius)}.admission-aside p{display:grid;border-bottom:1px solid #102b3f33;padding-bottom:.9rem}.admission-aside span,.admission-aside small{font-size:.78rem}.admission-aside strong{font-size:1.5rem}.notice-light{margin-top:1.2rem;background:#f4fae3;border-color:#82a325}.faq-list{border-top:1px solid var(--line)}.faq-item{border-bottom:1px solid var(--line)}.faq-item summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:1rem;padding:1.15rem .2rem;font-weight:700}.faq-item summary::-webkit-details-marker{display:none}.faq-plus{font-size:1.35rem;color:var(--teal-dark);transition:transform .2s}.faq-item[open] .faq-plus{transform:rotate(45deg)}.faq-answer{max-width:760px;padding:0 .3rem 1.2rem;color:#445b68}.faq-answer p{margin-bottom:.6rem}.references{padding-bottom:4rem}.reference-list{padding:0;list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:.6rem 1.3rem}.reference-list li{scroll-margin-top:6rem;display:grid;grid-template-columns:3rem 1fr;gap:.8rem;padding:1rem 0;border-top:1px solid #ffffff2a}.reference-list li:target{background:#ffffff12;outline:2px solid var(--lime);padding-left:.6rem}.ref-id{color:var(--lime);font-size:.78rem;font-weight:800}.reference-list strong{font-size:.83rem}.reference-list p{color:#c5d5dc;font-size:.78rem;margin:.35rem 0}.reference-list small{display:block;color:#aec2cc;font-size:.68rem}.reference-list a{display:inline-block;color:var(--lime);font-size:.76rem;font-weight:700;margin-top:.35rem}.footer{background:#051724;color:#c6d3da;padding:2rem max(calc((100% - 1120px)/2),1.4rem);font-size:.8rem;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap}.footer p{margin:0}.footer a{color:var(--lime)}@media(max-width:900px){.nav-wrap{align-items:flex-start}.nav-links{gap:.65rem;flex-wrap:wrap;justify-content:flex-end}.nav-links a{font-size:.75rem}.hero{min-height:0;grid-template-columns:1fr .7fr;padding-top:4rem}.hero-art{height:280px}.orbit-one{width:260px}.orbit-two{width:350px}.chip{width:145px;height:145px}.chip b{font-size:3.3rem}.semester-grid{grid-template-columns:repeat(2,1fr)}.support-grid{grid-template-columns:1fr 1fr}.support-card:last-child{grid-column:1/-1}.work-grid{grid-template-columns:1fr 1fr}.work-copy{grid-column:1/-1}.reference-list{grid-template-columns:1fr}}@media(max-width:620px){html{scroll-padding-top:8rem}.nav-wrap{display:block;padding:.65rem 1rem}.brand{margin-bottom:.6rem}.nav-links{justify-content:flex-start;overflow-x:auto;flex-wrap:nowrap;padding-bottom:.2rem}.nav-links a{white-space:nowrap}.hero{display:block;padding:3.4rem 1.1rem 1.4rem}.hero h1{font-size:clamp(2.8rem,15vw,4.3rem)}.lead{font-size:1.05rem}.hero-art{height:210px;margin:1.1rem 0}.orbit-one{width:230px;height:150px}.orbit-two{width:280px;height:190px}.chip{width:110px;height:110px;border-radius:1.5rem;padding:.8rem}.chip b{font-size:2.5rem}.art-label{right:2%;font-size:.6rem}.hero-facts{margin-top:1.4rem}.hero-facts span{font-size:.65rem}.hero-facts strong{font-size:.82rem}.section{padding:3.8rem 1.1rem}.compare-grid,.skill-grid,.support-grid,.work-grid,.admission-layout{grid-template-columns:1fr}.support-card:last-child,.work-copy{grid-column:auto}.compare-card{min-height:0}.semester-grid{grid-template-columns:1fr 1fr;gap:.55rem}.semester-card{padding:.8rem;min-height:0}.semester-card h3{font-size:1rem}.semester-card ul{font-size:.77rem;padding-left:.95rem}.weight-grid{grid-template-columns:repeat(2,1fr)}.reference-list li{grid-template-columns:2.3rem 1fr}.footer{padding:1.5rem 1.1rem}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{transition-duration:.01ms!important;animation-duration:.01ms!important}}
</style>


