---
interface Props { title: string; subtitle: string }
const { title, subtitle } = Astro.props;
---
<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">Universidad Tecnológica Metropolitana · UTEM</p>
    <h1 id="hero-title">{title}</h1>
    <p class="lead">{subtitle}</p>
    <div class="hero-actions"><a class="button button-accent" href="#plan">Conoce el plan publicado <span aria-hidden="true">↘</span></a><a class="text-link" href="#admision">Revisa cómo postular</a></div>
    <p class="hero-source">Datos de la ficha UTEM consultada en 2026: <a href="#ref-F01">fuente F01</a>.</p>
  </div>
  <div class="hero-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="chip"><span>UTEM</span><b>01</b></div><i class="dot dot-one"></i><i class="dot dot-two"></i><i class="dot dot-three"></i><span class="art-label">ideas → soluciones</span></div>
  <div class="hero-facts" aria-label="Datos generales publicados por UTEM en 2026"><div><span>Duración publicada</span><strong>8 semestres</strong></div><div><span>Jornada</span><strong>Diurna</strong></div><div><span>Campus</span><strong>Macul</strong></div></div>
</section>
